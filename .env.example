# --- Gemini (optional) ---
# GEMINI_API_KEY: server-side key. If missing/invalid the app shows a banner and
# falls back to the SIMULATED agent, always labelled as simulated.
GEMINI_API_KEY=""
# GEMINI_MODEL: not assumed to exist; checked with a tiny call at boot.
GEMINI_MODEL="gemini-2.5-flash"

# --- Server ---
PORT=3000
# Origin allowed by CORS (e.g. https://armora.example.com). Unset = same-origin only.
APP_URL=""
# DEMO_MODE defaults to true locally and false when NODE_ENV=production.
# DEMO_MODE=true enables /api/audit/tamper and the overrideToolCall parameter.
# DEMO_MODE=true
# Required for all mutating routes when NODE_ENV=production (send as x-admin-token).
ADMIN_TOKEN=""

# --- Secrets (all optional; random per boot when unset, with a console warning) ---
# 32 random bytes, base64 (Ed25519 seed for the credential broker):
# BROKER_ED25519_SEED=
# Key for audit-log HMAC (hex or any string >= 16 chars). If unset, a key file is
# created inside AUDIT_DIR (weaker: key and logs share the same disk).
# AUDIT_HMAC_KEY=
# Salt for PII evidence hashing:
# AUDIT_SALT_SECRET=
# Directory for the append-only audit JSONL + anchors files:
# AUDIT_DIR=./.audit
